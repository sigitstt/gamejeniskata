<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, maximum-scale=1.0">
  <title>Tembak Ular Kata - EduGame</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-user-select: none;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body, html {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: #0b0f19;
      color: #ffffff;
    }

    #app-wrapper {
      position: relative;
      width: 100vw;
      height: 100vh;
      display: flex;
      flex-direction: column;
      max-width: 480px;
      margin: 0 auto;
      background: #111827;
      box-shadow: 0 0 20px rgba(0,0,0,0.8);
    }

    /* Layout Layar */
    .screen {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      z-index: 10;
      background: #111827;
      padding: 20px;
      overflow-y: auto;
    }

    .hidden {
      display: none !important;
    }

    /* Form Identitas */
    .form-header {
      text-align: center;
      margin-top: 10px;
      margin-bottom: 20px;
    }

    .form-header h1 {
      font-size: 22px;
      color: #3b82f6;
      cursor: pointer;
    }

    .form-header p {
      font-size: 12px;
      color: #9ca3af;
      margin-top: 4px;
    }

    .input-group {
      margin-bottom: 14px;
    }

    .input-group label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 5px;
      color: #d1d5db;
    }

    .input-group input, .input-group select {
      width: 100%;
      padding: 11px;
      border-radius: 8px;
      border: 1px solid #374151;
      background: #1f2937;
      color: #fff;
      font-size: 14px;
      outline: none;
    }

    .input-group input:focus, .input-group select:focus {
      border-color: #3b82f6;
    }

    .btn-primary {
      width: 100%;
      padding: 13px;
      background: #2563eb;
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 15px;
      font-weight: bold;
      cursor: pointer;
      margin-top: 8px;
      transition: background 0.2s;
      touch-action: manipulation;
    }

    .btn-primary:active {
      background: #1d4ed8;
    }

    /* Header Permainan (Fixed Height) */
    #game-header {
      flex-shrink: 0;
      height: 46px;
      background: #1f2937;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 12px;
      border-bottom: 2px solid #374151;
      z-index: 5;
    }

    .stat-box {
      font-size: 12px;
      font-weight: bold;
    }

    .stat-value {
      color: #f59e0b;
    }

    /* Area Arena Canvas (Flex-grow agar responsif tanpa memotong tombol) */
    #canvas-container {
      flex: 1 1 auto;
      min-height: 0; /* PENTING: Mencegah canvas meluap memotong tombol HP */
      position: relative;
      background: #090d16;
    }

    canvas {
      display: block;
      width: 100%;
      height: 100%;
    }

    /* Panel Tombol (Fixed at Bottom, 2 Baris Kelihatan Utuh) */
    #controls-panel {
      flex-shrink: 0; /* PENTING: Mencegah tombol terpotong */
      padding: 6px;
      background: #111827;
      border-top: 1px solid #374151;
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 5px;
      z-index: 5;
    }

    .btn-word-type {
      background: #1e40af;
      color: #ffffff;
      border: 1px solid #3b82f6;
      padding: 8px 2px;
      font-size: 10px;
      font-weight: bold;
      border-radius: 6px;
      cursor: pointer;
      text-align: center;
      touch-action: manipulation;
      min-height: 38px;
      display: flex;
      align-items: center;
      justify-content: center;
      word-break: break-word;
      line-height: 1.1;
    }

    .btn-word-type:active {
      transform: scale(0.92);
      background: #3b82f6;
    }

    /* Modal Pengaturan Guru */
    .modal-overlay {
      position: fixed;
      top: 0; left: 0; width: 100vw; height: 100vh;
      background: rgba(0,0,0,0.85);
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 100;
    }

    .modal-content {
      background: #1f2937;
      width: 90%;
      max-width: 400px;
      padding: 18px;
      border-radius: 12px;
      border: 1px solid #4b5563;
      max-height: 90vh;
      overflow-y: auto;
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 15px;
    }

    .modal-header h2 {
      font-size: 17px;
      color: #f59e0b;
    }

    .close-btn {
      background: none;
      border: none;
      color: #9ca3af;
      font-size: 22px;
      cursor: pointer;
    }

    /* Game Over / Hasil */
    .result-card {
      background: #1f2937;
      padding: 20px;
      border-radius: 10px;
      text-align: center;
      margin-top: 20px;
    }

    .result-score {
      font-size: 42px;
      color: #10b981;
      font-weight: bold;
      margin: 10px 0;
    }

    /* Loading Overlay */
    #loading-overlay {
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(17, 24, 39, 0.92);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      z-index: 50;
      text-align: center;
      padding: 20px;
    }

    .spinner {
      border: 4px solid #374151;
      border-top: 4px solid #3b82f6;
      border-radius: 50%;
      width: 36px;
      height: 36px;
      animation: spin 1s linear infinite;
      margin-bottom: 12px;
    }

    @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
  </style>
</head>
<body>

<div id="app-wrapper">

  <!-- SCREEN 1: FORM IDENTITAS SISWA .................................... -->
  <div id="screen-identity" class="screen">
    <div class="form-header">
      <h1 id="title-app">TEMBAK2 ULAR KATA</h1>
      <p>Ketuk judul 5x untuk Pengaturan Guru</p>
    </div>

    <form id="identity-form">
      <div class="input-group">
        <label for="student-absen">No. Absen</label>
        <input type="number" id="student-absen" required placeholder="Contoh: 12" min="1">
      </div>

      <div class="input-group">
        <label for="student-name">Nama Lengkap</label>
        <input type="text" id="student-name" required placeholder="Masukkan nama lengkap">
      </div>

      <div class="input-group">
        <label for="student-class">Kelas</label>
        <input type="text" id="student-class" required placeholder="Contoh: X IPA 1">
      </div>

      <div class="input-group">
        <label for="test-type">Jenis Tes</label>
        <select id="test-type" required>
          <option value="Formatif">Formatif</option>
          <option value="Sumatif">Sumatif (Pakai Token)</option>
        </select>
      </div>

      <div class="input-group hidden" id="token-group">
        <label for="test-token">Token Sumatif</label>
        <input type="text" id="test-token" placeholder="Masukkan token tes">
      </div>

      <button type="submit" class="btn-primary">Mulai Permainan</button>
    </form>
  </div>

  <!-- SCREEN 2: GAMEPLAY -->
  <div id="screen-game" class="screen hidden" style="padding:0; overflow:hidden;">
    <div id="game-header">
      <div class="stat-box">Waktu: <span id="disp-timer" class="stat-value">0s</span></div>
      <div class="stat-box">Nyawa: <span id="disp-lives" class="stat-value">❤️❤️❤️</span></div>
      <div class="stat-box">Soal: <span id="disp-progress" class="stat-value">0/10</span></div>
      <div class="stat-box">Skor: <span id="disp-score" class="stat-value">0</span></div>
    </div>

    <div id="canvas-container">
      <canvas id="gameCanvas"></canvas>
    </div>

    <div id="controls-panel">
      <!-- 10 Tombol Jenis Kata (2 Baris Pas di Layar HP) -->
      <button class="btn-word-type" data-type="Nomina">Nomina</button>
      <button class="btn-word-type" data-type="Verba">Verba</button>
      <button class="btn-word-type" data-type="Adjektiva">Adjektiva</button>
      <button class="btn-word-type" data-type="Adverbia">Adverbia</button>
      <button class="btn-word-type" data-type="Pronomina">Pronomina</button>
      <button class="btn-word-type" data-type="Numeralia">Numeralia</button>
      <button class="btn-word-type" data-type="Preposisi">Preposisi</button>
      <button class="btn-word-type" data-type="Konjungsi">Konjungsi</button>
      <button class="btn-word-type" data-type="Interjeksi">Interjeksi</button>
      <button class="btn-word-type" data-type="Artikula">Artikula</button>
    </div>
  </div>

  <!-- SCREEN 3: GAME OVER / HASIL -->
  <div id="screen-result" class="screen hidden">
    <div class="form-header">
      <h1>PERMAINAN SELESAI</h1>
      <p id="result-status">Terima kasih telah menyelesaikan tes!</p>
    </div>

    <div class="result-card">
      <p>Skor Akhir Anda</p>
      <div class="result-score" id="final-score">0</div>
      <p id="result-detail" style="font-size:12px; color:#9ca3af; margin-bottom:15px;"></p>
      <button id="btn-restart" class="btn-primary">Main Lagi</button>
    </div>
  </div>

  <!-- MODAL: PENGATURAN GURU -->
  <div id="modal-settings" class="modal-overlay hidden">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Pengaturan Guru</h2>
        <button class="close-btn" id="btn-close-settings">&times;</button>
      </div>

      <form id="settings-form">
        <div class="input-group">
          <label for="cfg-lives">Jumlah Nyawa (Cell N2)</label>
          <input type="number" id="cfg-lives" min="1" max="10" required>
        </div>

        <div class="input-group">
          <label for="cfg-questions">Jumlah Soal (Cell N3)</label>
          <input type="number" id="cfg-questions" min="1" max="50" required>
        </div>

        <div class="input-group">
          <label for="cfg-time">Batas Waktu Total Detik (Cell N4)</label>
          <input type="number" id="cfg-time" min="10" max="600" required>
        </div>

        <div class="input-group">
          <label for="cfg-token">Token Sumatif (Cell N5)</label>
          <input type="text" id="cfg-token" required>
        </div>

        // MENGIRIM DATA KE GOOGLE SPREADSHEET ..............................................OK
        <div class="input-group">
          <label for="cfg-sheet-url">URL Web App Google Sheets</label>
          <input type="url" id="cfg-sheet-url" placeholder="https://script.google.com/macros/s/AKfycbwX29TuhfiEHCw_0rRgNaIPGGMQftlqggXbioCfo2jXWu0lE1OjVckbuAIolyzzJ4fRUw/exec">
        </div>

        <button type="submit" class="btn-primary">Simpan & Sync Ke Sheets</button>
      </form>
    </div>
  </div>

  <!-- LOADING OVERLAY -->
  <div id="loading-overlay" class="hidden">
    <div class="spinner"></div>
    <p id="loading-text">Memuat data...</p>
  </div>

</div>

<script>
/**
 * AUDIO SYNTHESIZER (Web Audio API)
 */
class AudioEngine {
  constructor() { this.ctx = null; }
  init() {
    if (!this.ctx) {
      const AudioCtx = window.AudioContext || window.webkitAudioContext;
      this.ctx = new AudioCtx();
    }
    if (this.ctx.state === 'suspended') {
      this.ctx.resume();
    }
  }

  playShoot() {
    if (!this.ctx) return;
    const osc = this.ctx.createOscillator();
    const gain = this.ctx.createGain();
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(600, this.ctx.currentTime);
    osc.frequency.exponentialRampToValueAtTime(100, this.ctx.currentTime + 0.12);
    gain.gain.setValueAtTime(0.2, this.ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.12);
    osc.connect(gain); gain.connect(this.ctx.destination);
    osc.start(); osc.stop(this.ctx.currentTime + 0.12);
  }

  playExplode() {
    if (!this.ctx) return;
    const osc = this.ctx.createOscillator();
    const gain = this.ctx.createGain();
    osc.type = 'triangle';
    osc.frequency.setValueAtTime(160, this.ctx.currentTime);
    osc.frequency.exponentialRampToValueAtTime(40, this.ctx.currentTime + 0.2);
    gain.gain.setValueAtTime(0.4, this.ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.2);
    osc.connect(gain); gain.connect(this.ctx.destination);
    osc.start(); osc.stop(this.ctx.currentTime + 0.2);
  }

  playWrong() {
    if (!this.ctx) return;
    const osc = this.ctx.createOscillator();
    const gain = this.ctx.createGain();
    osc.type = 'square';
    osc.frequency.setValueAtTime(150, this.ctx.currentTime);
    osc.frequency.setValueAtTime(100, this.ctx.currentTime + 0.1);
    gain.gain.setValueAtTime(0.25, this.ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.25);
    osc.connect(gain); gain.connect(this.ctx.destination);
    osc.start(); osc.stop(this.ctx.currentTime + 0.25);
  }

  playGameOver() {
    if (!this.ctx) return;
    [200, 160, 130, 100].forEach((freq, idx) => {
      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();
      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(freq, this.ctx.currentTime + (idx * 0.12));
      gain.gain.setValueAtTime(0.25, this.ctx.currentTime + (idx * 0.12));
      gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + (idx * 0.12) + 0.11);
      osc.connect(gain); gain.connect(this.ctx.destination);
      osc.start(this.ctx.currentTime + (idx * 0.12));
      osc.stop(this.ctx.currentTime + (idx * 0.12) + 0.11);
    });
  }
}

// BANK KATA DEFAULT (Penyangga jika tanpa internet)
const DEFAULT_WORD_BANK = [
  { word: "makan", type: "Verba" }, { word: "berlari", type: "Verba" },
  { word: "meja", type: "Nomina" }, { word: "kucing", type: "Nomina" },
  { word: "cantik", type: "Adjektiva" }, { word: "pintar", type: "Adjektiva" },
  { word: "sangat", type: "Adverbia" }, { word: "mereka", type: "Pronomina" },
  { word: "tiga", type: "Numeralia" }, { word: "di", type: "Preposisi" },
  { word: "dan", type: "Konjungsi" }, { word: "amboi", type: "Interjeksi" },
  { word: "sang", type: "Artikula" }
];

class GameApp {
  constructor() {
    this.audio = new AudioEngine();
    
    // Default Config (Diambil dari N2:N5)
    this.config = {
      maxLives: 3,
      totalQuestions: 10,
      timeLimit: 60,
      tokenSumatif: "GURU123",
      sheetUrl: ""
    };

    this.student = { absen: "", name: "", class: "", testType: "Formatif" };
    this.wordBank = [...DEFAULT_WORD_BANK];
    this.score = 0;
    this.lives = 3;
    this.questionCount = 0;
    this.timer = 60;
    this.timerInterval = null;
    this.gameRunning = false;

    this.canvas = document.getElementById('gameCanvas');
    this.ctx = this.canvas.getContext('2d');
    
    this.snake = null;
    this.bullets = [];
    this.particles = [];
    this.titleTapCount = 0;

    this.loadLocalConfig();
    this.initDOMEvents();
    this.resizeCanvas();
    window.addEventListener('resize', () => this.resizeCanvas());
  }

  loadLocalConfig() {
    const saved = localStorage.getItem('snake_game_config');
    if (saved) {
      try { this.config = { ...this.config, ...JSON.parse(saved) }; } catch (e) {}
    }
  }

  saveLocalConfig() {
    localStorage.setItem('snake_game_config', JSON.stringify(this.config));
  }

  resizeCanvas() {
    const container = document.getElementById('canvas-container');
    if (container) {
      this.canvas.width = container.clientWidth;
      this.canvas.height = container.clientHeight;
    }
  }

  initDOMEvents() {
    document.getElementById('title-app').addEventListener('click', () => {
      this.titleTapCount++;
      if (this.titleTapCount >= 5) {
        this.titleTapCount = 0;
        this.openSettingsModal();
      }
    });

    document.getElementById('identity-form').addEventListener('submit', (e) => {
      e.preventDefault();
      this.handleFormSubmit();
    });

    document.getElementById('test-type').addEventListener('change', (e) => {
      const tokenGroup = document.getElementById('token-group');
      if (e.target.value === 'Sumatif') {
        tokenGroup.classList.remove('hidden');
        document.getElementById('test-token').required = true;
      } else {
        tokenGroup.classList.add('hidden');
        document.getElementById('test-token').required = false;
      }
    });

    document.getElementById('btn-close-settings').addEventListener('click', () => {
      document.getElementById('modal-settings').classList.add('hidden');
    });

    document.getElementById('settings-form').addEventListener('submit', (e) => {
      e.preventDefault();
      this.saveSettings();
    });

    document.querySelectorAll('.btn-word-type').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const type = e.target.getAttribute('data-type');
        this.fireBullet(type);
      });
    });

    document.getElementById('btn-restart').addEventListener('click', () => {
      this.showScreen('screen-identity');
    });
  }

  openSettingsModal() {
    document.getElementById('cfg-lives').value = this.config.maxLives;
    document.getElementById('cfg-questions').value = this.config.totalQuestions;
    document.getElementById('cfg-time').value = this.config.timeLimit;
    document.getElementById('cfg-token').value = this.config.tokenSumatif;
    document.getElementById('cfg-sheet-url').value = this.config.sheetUrl;
    document.getElementById('modal-settings').classList.remove('hidden');
  }

  async saveSettings() {
    this.config.maxLives = parseInt(document.getElementById('cfg-lives').value);
    this.config.totalQuestions = parseInt(document.getElementById('cfg-questions').value);
    this.config.timeLimit = parseInt(document.getElementById('cfg-time').value);
    this.config.tokenSumatif = document.getElementById('cfg-token').value;
    this.config.sheetUrl = document.getElementById('cfg-sheet-url').value;

    this.saveLocalConfig();
    document.getElementById('modal-settings').classList.add('hidden');

    if (this.config.sheetUrl) {
      this.showLoading("Mengirim Pengaturan N2:N5 ke Google Sheets...");
      try {
        await fetch(this.config.sheetUrl, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'saveSettings',
            settings: this.config
          })
        });
        alert("Pengaturan disimpan ke cell N2:N5 Google Sheets!");
      } catch (err) {
        alert("Gagal sinkronisasi ke Sheets: " + err.message);
      } finally {
        this.hideLoading();
      }
    } else {
      alert("Pengaturan lokal disimpan!");
    }
  }

  showScreen(screenId) {
    document.querySelectorAll('.screen').forEach(s => s.classList.add('hidden'));
    document.getElementById(screenId).classList.remove('hidden');
  }

  showLoading(text) {
    document.getElementById('loading-text').innerText = text;
    document.getElementById('loading-overlay').classList.remove('hidden');
  }

  hideLoading() {
    document.getElementById('loading-overlay').classList.add('hidden');
  }

  async handleFormSubmit() {
    this.audio.init();

    this.student.absen = document.getElementById('student-absen').value;
    this.student.name = document.getElementById('student-name').value;
    this.student.class = document.getElementById('student-class').value;
    this.student.testType = document.getElementById('test-type').value;

    // Tarik data Soal & Pengaturan N2:N5 dari Google Sheets
    if (this.config.sheetUrl) {
      this.showLoading("Menghubungkan ke Google Sheets...");
      try {
        const response = await fetch(`${this.config.sheetUrl}?action=getInitData`);
        const data = await response.json();
        
        if (data.config) {
          this.config.maxLives = data.config.maxLives || this.config.maxLives;
          this.config.totalQuestions = data.config.totalQuestions || this.config.totalQuestions;
          this.config.timeLimit = data.config.timeLimit || this.config.timeLimit;
          this.config.tokenSumatif = data.config.tokenSumatif || this.config.tokenSumatif;
        }

        if (data.words && data.words.length > 0) {
          this.wordBank = data.words;
        }
      } catch (err) {
        console.warn("Gagal menarik data dari Sheets. Menggunakan bank soal lokal.");
      } finally {
        this.hideLoading();
      }
    }

    if (this.student.testType === 'Sumatif') {
      const inputToken = document.getElementById('test-token').value;
      if (inputToken !== this.config.tokenSumatif) {
        alert("Token Sumatif salah!");
        return;
      }
    }

    this.startGame();
  }

  startGame() {
    this.score = 0;
    this.lives = this.config.maxLives;
    this.questionCount = 0;
    this.timer = this.config.timeLimit;
    this.bullets = [];
    this.particles = [];

    this.updateHUD();
    this.showScreen('screen-game');
    this.resizeCanvas();

    this.spawnSnake();

    this.gameRunning = true;
    clearInterval(this.timerInterval);
    this.timerInterval = setInterval(() => {
      this.timer--;
      this.updateHUD();
      if (this.timer <= 0) {
        this.endGame("Waktu Habis!");
      }
    }, 1000);

    requestAnimationFrame(() => this.gameLoop());
  }

  updateHUD() {
    document.getElementById('disp-timer').innerText = `${this.timer}s`;
    document.getElementById('disp-score').innerText = this.score;
    document.getElementById('disp-progress').innerText = `${this.questionCount}/${this.config.totalQuestions}`;
    document.getElementById('disp-lives').innerText = "❤️".repeat(Math.max(0, this.lives));
  }

  spawnSnake() {
    if (this.questionCount >= this.config.totalQuestions) {
      this.endGame("Selamat! Semua soal telah selesai.");
      return;
    }

    this.questionCount++;
    this.updateHUD();

    const randomItem = this.wordBank[Math.floor(Math.random() * this.wordBank.length)];
    
    // PERBAIKAN 1: Kepala Lurus (X Tetap Di Tengah Canvas), Ekor Meliuk
    this.snake = {
      text: randomItem.word,
      type: randomItem.type,
      x: this.canvas.width / 2, // Kepala lurus tidak bergeser X
      y: -30,
      speed: 1.0 + Math.random() * 0.3,
      waveAngle: 0,
      radius: 24,
      bodySegments: []
    };

    for (let i = 0; i < 6; i++) {
      this.snake.bodySegments.push({ x: this.snake.x, y: this.snake.y - (i * 18) });
    }
  }

  fireBullet(type) {
    if (!this.gameRunning || !this.snake) return;
    this.audio.playShoot();
    this.bullets.push({
      x: this.canvas.width / 2,
      y: this.canvas.height - 10,
      targetType: type,
      speed: 14
    });
  }

  createExplosion(x, y, color) {
    for (let i = 0; i < 20; i++) {
      this.particles.push({
        x, y,
        vx: (Math.random() - 0.5) * 8,
        vy: (Math.random() - 0.5) * 8,
        life: 1.0,
        color: color || `hsl(${Math.random() * 360}, 100%, 50%)`
      });
    }
  }

  loseLife(reason) {
    this.lives--;
    this.audio.playWrong();
    this.updateHUD();
    this.createExplosion(this.snake.x, this.snake.y, '#ef4444');

    if (this.lives <= 0) {
      this.endGame("Nyawa Anda Habis!");
    } else {
      this.spawnSnake();
    }
  }

  gameLoop() {
    if (!this.gameRunning) return;

    this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

    // Render Partikel Ledakan
    for (let i = this.particles.length - 1; i >= 0; i--) {
      let p = this.particles[i];
      p.x += p.vx; p.y += p.vy; p.life -= 0.04;
      this.ctx.fillStyle = p.color;
      this.ctx.globalAlpha = Math.max(0, p.life);
      this.ctx.beginPath();
      this.ctx.arc(p.x, p.y, 4, 0, Math.PI * 2);
      this.ctx.fill();
      if (p.life <= 0) this.particles.splice(i, 1);
    }
    this.ctx.globalAlpha = 1.0;

    // Render Ular (Kepala Lurus, Ekor Bergoyang)
    if (this.snake) {
      this.snake.y += this.snake.speed;
      this.snake.waveAngle += 0.08;
      this.snake.x = this.canvas.width / 2; // KEPALA LURUS TURUN KE BAWAH

      // Gambar Ekor yang Bergoyang Meliuk-liuk
      for (let i = 0; i < this.snake.bodySegments.length; i++) {
        let seg = this.snake.bodySegments[i];
        let targetY = this.snake.y - (i + 1) * 18;
        // Hanya X pada ekor yang dikasi gelombang sinus!
        let targetX = this.snake.x + Math.sin(this.snake.waveAngle - i * 0.4) * (15 + i * 3);
        
        seg.x = targetX;
        seg.y = targetY;

        this.ctx.fillStyle = `hsl(${120 + i * 12}, 75%, 45%)`;
        this.ctx.beginPath();
        this.ctx.arc(seg.x, seg.y, 16 - (i * 1.5), 0, Math.PI * 2);
        this.ctx.fill();
      }

      // Gambar Kepala Ular (Fokus & Diam di Tengah)
      this.ctx.fillStyle = '#10b981';
      this.ctx.beginPath();
      this.ctx.arc(this.snake.x, this.snake.y, this.snake.radius, 0, Math.PI * 2);
      this.ctx.fill();
      this.ctx.strokeStyle = '#059669';
      this.ctx.lineWidth = 3;
      this.ctx.stroke();

      // Mata Ular
      this.ctx.fillStyle = '#ffffff';
      this.ctx.beginPath();
      this.ctx.arc(this.snake.x - 7, this.snake.y + 2, 4, 0, Math.PI * 2);
      this.ctx.arc(this.snake.x + 7, this.snake.y + 2, 4, 0, Math.PI * 2);
      this.ctx.fill();
      this.ctx.fillStyle = '#000';
      this.ctx.beginPath();
      this.ctx.arc(this.snake.x - 7, this.snake.y + 3, 2, 0, Math.PI * 2);
      this.ctx.arc(this.snake.x + 7, this.snake.y + 3, 2, 0, Math.PI * 2);
      this.ctx.fill();

      // Kata pada Kepala Ular
      this.ctx.fillStyle = '#ffffff';
      this.ctx.font = 'bold 16px sans-serif';
      this.ctx.textAlign = 'center';
      this.ctx.textBaseline = 'middle';
      this.ctx.fillText(this.snake.text, this.snake.x, this.snake.y - 35);

      // Cek Jika Ular Lolos ke Bawah Layar
      if (this.snake.y > this.canvas.height - 15) {
        this.loseLife("Ular tidak tertembak!");
      }
    }

    // Render Peluru Tembakan
    for (let i = this.bullets.length - 1; i >= 0; i--) {
      let b = this.bullets[i];
      b.y -= b.speed;

      this.ctx.fillStyle = '#f59e0b';
      this.ctx.beginPath();
      this.ctx.arc(b.x, b.y, 6, 0, Math.PI * 2);
      this.ctx.fill();

      // Deteksi Tabrakan dengan Kepala Ular
      if (this.snake) {
        let dx = b.x - this.snake.x;
        let dy = b.y - this.snake.y;
        let dist = Math.sqrt(dx * dx + dy * dy);

        if (dist < this.snake.radius + 6) {
          if (b.targetType === this.snake.type) {
            this.score += 10;
            this.audio.playExplode();
            this.createExplosion(this.snake.x, this.snake.y, '#10b981');
            this.spawnSnake();
          } else {
            this.loseLife("Tebakan jenis kata salah!");
          }
          this.bullets.splice(i, 1);
          continue;
        }
      }

      if (b.y < 0) this.bullets.splice(i, 1);
    }

    requestAnimationFrame(() => this.gameLoop());
  }

  async endGame(reason) {
    this.gameRunning = false;
    clearInterval(this.timerInterval);
    this.audio.playGameOver();

    document.getElementById('result-status').innerText = reason;
    document.getElementById('final-score').innerText = this.score;
    document.getElementById('result-detail').innerText = 
      `Siswa: ${this.student.name} (${this.student.absen}) | Kelas: ${this.student.class} | Tes: ${this.student.testType}`;

    this.showScreen('screen-result');

    // PERBAIKAN 3: Pengiriman Nilai ke Tab "Formatif" / "Sumatif"
    if (this.config.sheetUrl) {
      this.showLoading(`Mengirim nilai ke Tab ${this.student.testType}...`);
      try {
        await fetch(this.config.sheetUrl, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'saveResult',
            result: {
              absen: this.student.absen,
              nama: this.student.name,
              kelas: this.student.class,
              jenisTes: this.student.testType, // 'Formatif' atau 'Sumatif'
              skor: this.score,
              waktuSisa: this.timer
            }
          })
        });
      } catch (e) {
        console.error("Gagal mengirim nilai.", e);
      } finally {
        this.hideLoading();
      }
    }
  }
}

window.addEventListener('load', () => {
  window.gameApp = new GameApp();
});
</script>
